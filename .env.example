# Copy to .env and fill in real values. Never commit your real .env.
# Adapters read these when the corresponding config value is absent.

# Mastodon
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your-mastodon-access-token

# Twitter / X (user-context OAuth2 bearer token; app-only tokens cannot post)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
